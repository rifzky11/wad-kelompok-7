# Koneksi langsung ke PostgreSQL (tanpa Supabase SDK)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Untuk Supabase: Settings > Database > Connection string > URI (mode: Transaction/Session)
# Host pooler WAJIB sesuai region project, contoh region: ap-northeast-1, ap-southeast-1, us-east-1.
# Jika password mengandung karakter khusus (&, @, #, /, :), encode dengan encodeURIComponent().
# Contoh nyata: postgresql://postgres.abcdefghijklmnop:rahasia%40ku@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Set ke "false" jika menggunakan database lokal tanpa SSL
DATABASE_SSL=true

# Secret untuk JWT (bisa diisi bebas, minimal 32 karakter)
JWT_SECRET=ganti_dengan_secret_yang_aman_minimal_32_karakter
