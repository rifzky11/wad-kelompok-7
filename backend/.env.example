# Koneksi langsung ke PostgreSQL (tanpa Supabase SDK)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Untuk Supabase: cari di Settings > Database > Connection string > URI (mode: Transaction/Session)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Set ke "false" jika menggunakan database lokal tanpa SSL
DATABASE_SSL=true

# Secret untuk JWT (bisa diisi bebas, minimal 32 karakter)
JWT_SECRET=ganti_dengan_secret_yang_aman_minimal_32_karakter
